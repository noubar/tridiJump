{
  "name": "tridijump",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight browser extension for unified 3D-model search.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run typecheck && vite build",
    "build:firefox": "npm run typecheck && vite build --mode firefox",
    "lexicon:fetch": "node scripts/lexicon/fetch.ts",
    "lexicon:build": "node scripts/lexicon/build.ts",
    "release": "node scripts/release.mjs all",
    "release:chrome": "node scripts/release.mjs chrome",
    "release:firefox": "node scripts/release.mjs firefox",
    "release:check": "node scripts/release.mjs all --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
